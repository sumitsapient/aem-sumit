<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="DG Banner Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <icon
                        granite:class="cq-dialog-dropdown-showhide"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Banner Variation"
                        name="./bannerVariation">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            cq-dialog-dropdown-showhide-target=".dg-banner-showhide-target"/>
                        <items jcr:primaryType="nt:unstructured">
                            <none
                                jcr:primaryType="nt:unstructured"
                                text="Select"
                                value="none"/>
                            <imageText
                                granite:hide="${cqDesign.disableImageText}"
                                jcr:primaryType="nt:unstructured"
                                text="Hero Image with Text"
                                value="imageText"/>
                            <imageOnly
                                granite:hide="${cqDesign.disableImage}"
                                jcr:primaryType="nt:unstructured"
                                text="Hero Image"
                                value="image"/>
                            <imageTile
                                granite:hide="${cqDesign.disableImageTile4}"
                                jcr:primaryType="nt:unstructured"
                                text="Hero Image with Tile - 2x2"
                                value="imageTile4"/>
                            <imageRepeat
                                granite:hide="${cqDesign.disableHeroImageChild2}"
                                jcr:primaryType="nt:unstructured"
                                text="Hero Image with Child Image - 1x1"
                                value="heroImageChild2"/>
                            <bottomTileSix
                                granite:hide="${cqDesign.bottomTile6}"
                                jcr:primaryType="nt:unstructured"
                                text="Bottom Tiles (4/6/10)"
                                value="bottomTile6"/>
                            <bottomTileFour
                                granite:hide="${cqDesign.bottomTile4}"
                                jcr:primaryType="nt:unstructured"
                                text="Bottom Tiles - 4"
                                value="bottomTile4"/>
                            <bottomTileFourAndTwoImage
                                granite:hide="${cqDesign.bottomTileTwoImage}"
                                jcr:primaryType="nt:unstructured"
                                text="Two Image &amp; Bottom Tiles - 4"
                                value="bottomTileTwoImage"/>
                            <tileOnly
                                granite:hide="${cqDesign.tileOnly}"
                                jcr:primaryType="nt:unstructured"
                                text="Tile - 6"
                                value="tileOnly"/>
                            <twoImage
                                granite:hide="${cqDesign.twoImage}"
                                jcr:primaryType="nt:unstructured"
                                text="Image - 1x1"
                                value="twoImage"/>
                            <fourImage
                                granite:hide="${cqDesign.fourImage}"
                                jcr:primaryType="nt:unstructured"
                                text="Image - 2x2"
                                value="fourImage"/>
                            <mobileCarousel
                                granite:hide="${cqDesign.mobile}"
                                jcr:primaryType="nt:unstructured"
                                text="Mobile Carousel"
                                value="mobile"/>
                        </items>
                    </icon>
                    <setImageText
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="imageText"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <bannerImage
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                        autoStart="{Boolean}false"
                                        class="cq-droptarget"
                                        fileNameParameter="./bannerImageName"
                                        fileReferenceParameter="./bannerImageReference"
                                        mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                        multiple="{Boolean}false"
                                        name="./bannerImage"
                                        title="Upload Image"
                                        uploadUrl="${suffix.path}"
                                        useHTML5="{Boolean}true"/>
                                    <bannerText
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                        fieldDescription="Text to be displayed on R.H.S of Hero Image."
                                        fieldLabel="Banner Text"
                                        name="./bannerText"/>
                                    <bannerImagePath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldDescription="It will have lower precedence when images are added on both."
                                        fieldLabel="Banner Image"
                                        name="./bannerImagePath"/>
                                </items>
                            </well>
                        </items>
                    </setImageText>
                    <setImageOnly
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="image"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <bannerImageOnly
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                        autoStart="{Boolean}false"
                                        class="cq-droptarget"
                                        fileNameParameter="./bannerImageOnlyName"
                                        fileReferenceParameter="./bannerImageOnlyReference"
                                        mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                        multiple="{Boolean}false"
                                        name="./bannerImageOnly"
                                        title="Upload Image"
                                        uploadUrl="${suffix.path}"
                                        useHTML5="{Boolean}true"/>
                                    <bannerImagePath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldDescription="It will have lower precedence when images are added on both."
                                        fieldLabel="Hero Image"
                                        name="./bannerImageOnlyPath"/>
                                </items>
                            </well>
                        </items>
                    </setImageOnly>
                    <setImageTile
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="imageTile4"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <bannerImageTile
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                        autoStart="{Boolean}false"
                                        class="cq-droptarget"
                                        fileNameParameter="./bannerImageTileName"
                                        fileReferenceParameter="./bannerImageTileReference"
                                        mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                        multiple="{Boolean}false"
                                        name="./bannerImageTile"
                                        title="Upload Image"
                                        uploadUrl="${suffix.path}"
                                        useHTML5="{Boolean}true"/>
                                    <bannerImagePosition
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                        fieldLabel="Align Image"
                                        name="./bannerTilePosition">
                                        <items jcr:primaryType="nt:unstructured">
                                            <right
                                                jcr:primaryType="nt:unstructured"
                                                text="Right"
                                                value="right"/>
                                            <left
                                                jcr:primaryType="nt:unstructured"
                                                text="Left"
                                                value="left"/>
                                        </items>
                                    </bannerImagePosition>
                                    <bannerImagePath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldDescription="It will have lower precedence when images are added on both."
                                        fieldLabel="Banner Image"
                                        name="./bannerImageTilePath"/>
                                </items>
                            </well>
                        </items>
                    </setImageTile>
                    <setImageRepeat
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="heroImageChild2"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <bannerImageRepeat
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                        autoStart="{Boolean}false"
                                        class="cq-droptarget"
                                        fileNameParameter="./bannerImageRepeatName"
                                        fileReferenceParameter="./bannerImageRepeatReference"
                                        mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                        multiple="{Boolean}false"
                                        name="./bannerImageRepeat"
                                        title="Upload Image"
                                        uploadUrl="${suffix.path}"
                                        useHTML5="{Boolean}true"/>
                                    <imagePositionRepeat
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                        fieldLabel="Align Hero Image"
                                        name="./imagePositionRepeat">
                                        <items jcr:primaryType="nt:unstructured">
                                            <right
                                                jcr:primaryType="nt:unstructured"
                                                text="Right"
                                                value="right"/>
                                            <left
                                                jcr:primaryType="nt:unstructured"
                                                text="Left"
                                                value="left"/>
                                        </items>
                                    </imagePositionRepeat>
                                    <bannerImageChildOne
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Child Image 1"
                                        name="./childImage1"/>
                                    <bannerImageChildTwo
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Child Image 2"
                                        name="./childImage2"/>
                                </items>
                            </well>
                        </items>
                    </setImageRepeat>
                    <setbottomTileSix
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="bottomTile6"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <bannerImageBottomTile
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                        autoStart="{Boolean}false"
                                        class="cq-droptarget"
                                        fileNameParameter="./bannerImageBottomTileName"
                                        fileReferenceParameter="./bannerImageBottomTileReference"
                                        mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                        multiple="{Boolean}false"
                                        name="./bannerImageBottomTile"
                                        title="Upload Image"
                                        uploadUrl="${suffix.path}"
                                        useHTML5="{Boolean}true"/>
                                    <bannerImageChildOne
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Child Image 1"
                                        name="./bottomTileChild1"/>
                                    <bannerImageChildTwo
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Child Image 2"
                                        name="./bottomTileChild2"/>
                                </items>
                            </well>
                        </items>
                    </setbottomTileSix>
                    <setbottomTileFour
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="bottomTile4"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <bannerImageBottomTile
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                        autoStart="{Boolean}false"
                                        class="cq-droptarget"
                                        fileNameParameter="./bannerImageBottomTileFourName"
                                        fileReferenceParameter="./bannerImageBottomTileFourReference"
                                        mimeTypes="[image/gif,image/jpeg,image/png,image/tiff,image/svg+xml]"
                                        multiple="{Boolean}false"
                                        name="./bannerImageBottomTileFour"
                                        title="Upload Image"
                                        uploadUrl="${suffix.path}"
                                        useHTML5="{Boolean}true"/>
                                    <bannerImageChildOne
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Child Image 1"
                                        name="./bottomTileFourChild1"/>
                                    <bannerImageChildTwo
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Child Image 2"
                                        name="./bottomTileFourChild2"/>
                                </items>
                            </well>
                        </items>
                    </setbottomTileFour>
                    <setbottomTileFourTwoImage
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="bottomTileTwoImage"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <bannerImageChildOne
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Child Image 1"
                                        name="./bottomTileFourChildTwoImage1"/>
                                    <bannerImageChildTwo
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Child Image 2"
                                        name="./bottomTileFourChildTwoImage2"/>
                                </items>
                            </well>
                        </items>
                    </setbottomTileFourTwoImage>
                    <settileOnly
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="tileOnly"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured"/>
                            </well>
                        </items>
                    </settileOnly>
                    <setTwoImage
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="twoImage"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <imageOne
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 1"
                                        name="./imageOne"/>
                                    <imageTwo
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 2"
                                        name="./imageTwo"/>
                                </items>
                            </well>
                        </items>
                    </setTwoImage>
                    <setFourImage
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="fourImage"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <imageOne
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 1"
                                        name="./image1"/>
                                    <imageTwo
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 2"
                                        name="./image2"/>
                                    <imageThree
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 3"
                                        name="./image3"/>
                                    <imageFour
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 4"
                                        name="./image4"/>
                                </items>
                            </well>
                        </items>
                    </setFourImage>
                    <mobileCarousel
                        granite:class="hide dg-banner-showhide-target foundation-layout-util-vmargin"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            showhidetargetvalue="mobile"/>
                        <items jcr:primaryType="nt:unstructured">
                            <well
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/well">
                                <items jcr:primaryType="nt:unstructured">
                                    <imageOne
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 1"
                                        name="./mobile1"/>
                                    <imageTwo
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 2"
                                        name="./mobile2"/>
                                    <imageThree
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Hero Image 3"
                                        name="./mobile3"/>
                                </items>
                            </well>
                        </items>
                    </mobileCarousel>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
