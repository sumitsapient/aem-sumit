<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Video Teaser"
    sling:resourceType="cq/gui/components/authoring/dialog"
    helpPath="https://www.adobe.com/go/aem_cmp_embed_v1">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <properties
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Properties"
                        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <modestbrandingDisabled
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="false"
                                        fieldDescription="When checked,prevent the YouTube logo from displaying in the control bar"
                                        name="./modestbranding"
                                        text="Hide Modest Branding"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                    <autoPlay
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="false"
                                        fieldDescription="When checked, video will automatically start to play when the player loads."
                                        name="./autoPlay"
                                        text="Enable AutoPlay"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                    <keyboardControl
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="false"
                                        fieldDescription="When checked, causes the player to not respond to keyboard controls."
                                        name="./keyBoardControl"
                                        text="Disable Keyboard Control"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                    <showAnnotation
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="false"
                                        fieldDescription="When checked, causes video annotations to not be shown by default."
                                        name="./annotation"
                                        text="Hide Annotations"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                    <allowedEmbeddables
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                        deleteHint="{Boolean}true"
                                        fieldDescription="The embeddables that are allowed to be selected by an author when embeddables are not disabled."
                                        fieldLabel="Allowed Embeddables"
                                        multiple="{Boolean}true"
                                        name="./allowedEmbeddables">
                                        <datasource
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="core/wcm/components/embed/v1/datasources/embeddables"/>
                                    </allowedEmbeddables>
                                    <urlDisabled
                                        jcr:primaryType="nt:unstructured"
                                        sling:hideResource="{Boolean}true"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="false"
                                        fieldDescription="When checked, disables the ability of content authors to enter a URL for rendering a widget."
                                        name="./urlDisabled"
                                        text="Disable URL"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                    <htmlDisabled
                                        jcr:primaryType="nt:unstructured"
                                        sling:hideResource="{Boolean}true"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="false"
                                        fieldDescription="When checked, disables the ability of content authors to enter free-form html for rendering a widget."
                                        name="./htmlDisabled"
                                        text="Disable HTML"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                    <embeddablesDisabled
                                        jcr:primaryType="nt:unstructured"
                                        sling:hideResource="{Boolean}true"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="false"
                                        fieldDescription="When checked, disables the ability of content authors to select an embeddable from a list of allowed embeddables."
                                        name="./embeddablesDisabled"
                                        text="Disable embeddables"
                                        uncheckedValue="false"
                                        value="{Boolean}true"/>
                                </items>
                            </column>
                        </items>
                    </properties>
                    <styletab
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/include"
                        path="/mnt/overlay/cq/gui/components/authoring/dialog/style/tab_design/styletab"/>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
