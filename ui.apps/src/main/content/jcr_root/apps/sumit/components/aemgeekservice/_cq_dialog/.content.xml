<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Dialog Props"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <tabs
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/tabs"
                        maximized="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <basic
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Basic"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <fname
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="First Name"
                                        name="./firstName"/>
                                    <lname
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Last Name"
                                        name="./lastName"/>
                                    <isprofessor
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                        checked="false"
                                        fieldDescription="Is author a professor"
                                        name="./professor"
                                        text="Is Professor"
                                        uncheckedValue="false"
                                        value="true"/>
                                </items>
                            </basic>
                            <multifield
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Multifield"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <authorname
                                        granite:class="sumit-author"
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Author Name"
                                        name="./author"
                                        validation="authorname"/>
                                    <well
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/well"
                                        fieldLabel="Book Details">
                                        <items jcr:primaryType="nt:unstructured">
                                            <books
                                                granite:class="sumit-multifield"
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}false"
                                                fieldLabel="Authors Book(Composite False)"
                                                validation="geeks-multifield">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    name="./books"/>
                                                <granite:data
                                                    jcr:primaryType="nt:unstructured"
                                                    max-items="5"
                                                    min-items="3"/>
                                            </books>
                                            <bookdetails
                                                granite:class="foundation-toggleable cmp-teaser__editor-multifield_actions"
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldLabel="Authors Book(Composite True)">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    emptyText="Book Details"
                                                    name="./bookdetails">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <book
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            emptyText="Book Name"
                                                            fieldLabel="Book Name"
                                                            name="./bookName"/>
                                                        <subject
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            emptyText="Subject"
                                                            fieldLabel="Subject"
                                                            name="./subject"/>
                                                        <published
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            emptyText="Published"
                                                            fieldLabel="Published"
                                                            name="./published"/>
                                                    </items>
                                                </field>
                                            </bookdetails>
                                        </items>
                                    </well>
                                </items>
                            </multifield>
                            <nestedmultifield
                                jcr:primaryType="nt:unstructured"
                                jcr:title="Nested Multifield"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <well
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/well"
                                        fieldLabel="Book Details">
                                        <items jcr:primaryType="nt:unstructured">
                                            <bookdetailswithnestedmultifield
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                composite="{Boolean}true"
                                                fieldDescription="Books Details"
                                                fieldLabel="Book Details"
                                                required="{Boolean}false">
                                                <field
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                                    emptyText="Books Details"
                                                    name="./bookdetailswithnestedmultifield">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <bookname
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            emptyText="Book Name"
                                                            fieldLabel="Book Name"
                                                            name="./bookname"/>
                                                        <booksubject
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                            emptyText="Book Subject"
                                                            fieldLabel="Book Subject"
                                                            name="./booksubject"/>
                                                        <bookeditons
                                                            jcr:primaryType="nt:unstructured"
                                                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                                            composite="{Boolean}true"
                                                            fieldDescription="Book Editions detail."
                                                            fieldLabel="Book Editions"
                                                            required="{Boolean}false">
                                                            <field
                                                                jcr:primaryType="nt:unstructured"
                                                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                                                emptyText="Book Editions"
                                                                name="./bookeditons">
                                                                <items jcr:primaryType="nt:unstructured">
                                                                    <editiondate
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                                                                        emptyText="Editon Date"
                                                                        fieldLabel="Editon Date"
                                                                        name="./editondate"/>
                                                                    <bookediton
                                                                        jcr:primaryType="nt:unstructured"
                                                                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                                                        fieldDescription="This field contains book edition."
                                                                        fieldLabel="Book Edition"
                                                                        name="./bookediton"
                                                                        step="1"
                                                                        value="1"/>
                                                                </items>
                                                            </field>
                                                        </bookeditons>
                                                    </items>
                                                </field>
                                            </bookdetailswithnestedmultifield>
                                        </items>
                                    </well>
                                </items>
                            </nestedmultifield>
                        </items>
                    </tabs>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
