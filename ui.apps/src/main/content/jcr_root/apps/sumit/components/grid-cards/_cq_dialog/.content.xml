<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="grid-cards.jcrTitle"
    sling:resourceType="cq/gui/components/authoring/dialog"
    group="H-D.Media">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <generalTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="grid-cards.generalTab.jcrTitle"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <heroCardPosition
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldDescription="grid-cards.generalTab.heroCardPosition.fieldDescription"
                                fieldLabel="grid-cards.generalTab.heroCardPosition.fieldLabel"
                                name="./heroPosition"
                                required="{Boolean}true"
                                value="">
                                <items jcr:primaryType="nt:unstructured">
                                    <left
                                        jcr:primaryType="nt:unstructured"
                                        selected="true"
                                        text="grid-cards.generalTab.heroCardPosition.left.text"
                                        value="left"/>
                                    <right
                                        jcr:primaryType="nt:unstructured"
                                        text="grid-cards.generalTab.heroCardPosition.right.text"
                                        value="right"/>
                                </items>
                            </heroCardPosition>
                            <cardDesign
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldDescription="grid-cards.generalTab.cardDesign.fieldDescription"
                                fieldLabel="grid-cards.generalTab.cardDesign.fieldLabel"
                                name="./cardDesign"
                                required="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <below
                                        jcr:primaryType="nt:unstructured"
                                        selected="true"
                                        text="grid-cards.generalTab.cardDesign.below.text"
                                        value="below"/>
                                    <blackOverlay
                                        jcr:primaryType="nt:unstructured"
                                        text="grid-cards.generalTab.cardDesign.blackOverlay.text"
                                        value="blackOverlay"/>
                                </items>
                            </cardDesign>
                        </items>
                    </generalTab>
                    <heroTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="grid-cards.heroTab.jcrTitle"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <image
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldDescription="grid-cards.heroTab.image.fieldDescription"
                                fieldLabel="grid-cards.heroTab.image.fieldLabel"
                                name="./heroImage"
                                required="{Boolean}true"/>
                            <altImageText
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="grid-cards.heroTab.altImageText.fieldDescription"
                                fieldLabel="grid-cards.heroTab.altImageText.fieldLabel"
                                name="./heroImageAltText"/>
                            <labelHeroTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="grid-cards.heroTab.labelHeroTitle.fieldDescription"
                                fieldLabel="grid-cards.heroTab.labelHeroTitle.fieldLabel"
                                name="./heroTitle"/>
                            <labelCTA
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="grid-cards.heroTab.labelCTA.fieldDescription"
                                fieldLabel="grid-cards.heroTab.labelCTA.fieldLabel"
                                name="./heroCTA"
                                required="{Boolean}true"/>
                            <pathItem
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldDescription="grid-cards.heroTab.pathItem.fieldDescription"
                                fieldLabel="grid-cards.heroTab.pathItem.fieldLabel"
                                name="./heroUrl"
                                required="{Boolean}true"/>
                            <targetItem
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldDescription="grid-cards.heroTab.targetItem.fieldDescription"
                                fieldLabel="grid-cards.heroTab.targetItem.fieldLabel"
                                name="./heroTarget">
                                <items jcr:primaryType="nt:unstructured">
                                    <currentTab
                                        jcr:primaryType="nt:unstructured"
                                        selected="true"
                                        text="grid-cards.heroTab.targetItem.currentTab.text"
                                        value="currentTab"/>
                                    <newTab
                                        jcr:primaryType="nt:unstructured"
                                        text="grid-cards.heroTab.targetItem.newTab.text"
                                        value="newTab"/>
                                </items>
                            </targetItem>
                        </items>
                    </heroTab>
                    <gridItemsTab
                        jcr:primaryType="nt:unstructured"
                        jcr:title="grid-cards.gridItems.jcrTitle"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <titleGridItem
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="grid-cards.gridItemsTab.titleGridItem.fieldDescription"
                                fieldLabel="grid-cards.gridItemsTab.titleGridItem.fieldLabel"
                                name="./gridItemsTitle"/>
                            <labelGridItemLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="grid-cards.gridItemsTab.labelGridItemLink.fieldDescription"
                                fieldLabel="grid-cards.gridItemsTab.labelGridItemLink.fieldLabel"
                                name="./gridItemsLinkLabel"/>
                            <pathGridItemLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldDescription="grid-cards.gridItemsTab.pathGridItemLink.fieldDescription"
                                fieldLabel="grid-cards.gridItemsTab.pathGridItemLink.fieldLabel"
                                name="./gridItemsLinkUrl"/>
                            <targetGridItemLink
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldDescription="grid-cards.gridItemsTab.targetGridItemLink.fieldDescription"
                                fieldLabel="grid-cards.gridItemsTab.targetGridItemLink.fieldLabel"
                                name="./gridItemsLinkTarget">
                                <items jcr:primaryType="nt:unstructured">
                                    <currentTab
                                        jcr:primaryType="nt:unstructured"
                                        selected="true"
                                        text="grid-cards.gridItemsTab.targetGridItemLink.currentTab.text"
                                        value="currentTab"/>
                                    <newTab
                                        jcr:primaryType="nt:unstructured"
                                        text="grid-cards.gridItemsTab.targetGridItemLink.newTab.text"
                                        value="newTab"/>
                                </items>
                            </targetGridItemLink>
                            <gridItems
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldLabel="grid-cards.gridItemsTab.gridItems.fieldLabel"
                                name="./gridItems">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./gridItems">
                                    <items jcr:primaryType="nt:unstructured">
                                        <column
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/container">
                                            <items jcr:primaryType="nt:unstructured">
                                                <image
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    fieldDescription="grid-cards.gridItemsTab.gridItems.field.column.image.fieldDescription"
                                                    fieldLabel="grid-cards.gridItemsTab.gridItems.field.column.image.fieldLabel"
                                                    name="./image"
                                                    required="{Boolean}true"/>
                                                <altImageText
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="grid-cards.gridItemsTab.gridItems.field.column.altImageText.fieldDescription"
                                                    fieldLabel="grid-cards.gridItemsTab.gridItems.field.column.altImageText.fieldLabel"
                                                    name="./imageAltText"/>
                                                <labelItemTitle
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="grid-cards.gridItemsTab.gridItems.field.column.labelItemTitle.fieldDescription"
                                                    fieldLabel="grid-cards.gridItemsTab.gridItems.field.column.labelItemTitle.fieldLabel"
                                                    name="./itemTitle"
                                                    required="{Boolean}true"/>
                                                <labelCTA
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                    fieldDescription="grid-cards.gridItemsTab.gridItems.field.column.labelCTA.fieldDescription"
                                                    fieldLabel="grid-cards.gridItemsTab.gridItems.field.column.labelCTA.fieldLabel"
                                                    name="./itemCTA"/>
                                                <pathItem
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                                    fieldDescription="grid-cards.gridItemsTab.gridItems.field.column.pathItem.fieldDescription"
                                                    fieldLabel="grid-cards.gridItemsTab.gridItems.field.column.pathItem.fieldLabel"
                                                    name="./itemUrl"
                                                    required="{Boolean}true"/>
                                                <targetItem
                                                    jcr:primaryType="nt:unstructured"
                                                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                                    fieldDescription="grid-cards.gridItemsTab.gridItems.field.column.targetItem.fieldDescription"
                                                    fieldLabel="grid-cards.gridItemsTab.gridItems.field.column.targetItem.fieldLabel"
                                                    name="./itemTarget">
                                                    <items jcr:primaryType="nt:unstructured">
                                                        <currentTab
                                                            jcr:primaryType="nt:unstructured"
                                                            selected="true"
                                                            text="grid-cards.gridItemsTab.gridItems.field.column.targetItem.currentTab.text"
                                                            value="currentTab"/>
                                                        <newTab
                                                            jcr:primaryType="nt:unstructured"
                                                            text="grid-cards.gridItemsTab.gridItems.field.column.targetItem.newTab.text"
                                                            value="newTab"/>
                                                    </items>
                                                </targetItem>
                                            </items>
                                        </column>
                                    </items>
                                </field>
                            </gridItems>
                        </items>
                    </gridItemsTab>
                    <seoTab
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/include"
                        path="/apps/h-d/widgets/seo/dialogTab"/>
                    <miscTab
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/include"
                        path="/apps/h-d/widgets/common/misc/dialogTab"/>
                    <accessibilityTab
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/include"
                        path="/apps/h-d/components/media/grid-cards/dialog-tabs/accessibility"/>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
